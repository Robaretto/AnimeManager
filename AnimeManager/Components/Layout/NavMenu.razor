<nav class="navbar navbar-expand-lg navbar-gradient shadow-sm px-4">
    <div class="container-fluid">

        <!-- Título -->
        <a class="navbar-brand" href="/">
            <span>🌸 AnimeManager</span>
        </a>

        <!-- Botón hamburguesa -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContenido">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Menú desplegable -->
        <div class="collapse navbar-collapse" id="navbarContenido">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                        <i class="bi bi-collection-play-fill me-1"></i> Animes
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/usuarios">
                        <i class="bi bi-people-fill me-1"></i> Usuarios
                    </NavLink>
                </li>
            </ul>

            <!-- Login o saludo -->
            <ul class="navbar-nav">
                @if (AuthService.ObtenerUsuarioLogueado() is null)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/login">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
                        </NavLink>
                    </li>
                }
                else
                {
                    <li class="nav-item me-2 mt-2 text-white small">
                        Hola, @AuthService.ObtenerUsuarioLogueado()?.Nombre
                    </li>
                    <li class="nav-item">
                        <button class="btn btn-outline-light btn-sm" @onclick="CerrarSesion">
                            <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
                        </button>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

@code {
    [Inject] private NavigationManager NavigationManager { get; set; }
    [Inject] private AuthService AuthService { get; set; }

    private void CerrarSesion()
    {
        AuthService.Logout();
        NavigationManager.NavigateTo("/login");
    }
}
