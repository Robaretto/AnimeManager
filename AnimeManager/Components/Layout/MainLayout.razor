@inherits LayoutComponentBase
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<!-- NAVBAR SUPERIOR -->
<nav class="navbar navbar-expand-lg navbar-dark" style="background: linear-gradient(to right, #444, #ccc);">
    <div class="container-fluid">
        <!-- Logo y nombre -->
        <a class="navbar-brand fw-bold text-pink" href="/">
            <i class="bi bi-flower1"></i> AnimeManager
        </a>

        <!-- Botón hamburguesa -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContenido">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Menú colapsable -->
        <div class="collapse navbar-collapse" id="navbarContenido">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                        <i class="bi bi-collection-play-fill me-1"></i> Animes
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/usuarios">
                        <i class="bi bi-people-fill me-1"></i> Usuarios
                    </NavLink>
                </li>
            </ul>

            <ul class="navbar-nav">
                @if (AuthService.ObtenerUsuarioLogueado() is null)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/login">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
                        </NavLink>
                    </li>
                }
                else
                {
                    <li class="nav-item d-flex align-items-center">
                        <span class="text-light me-2 small">Hola, @AuthService.ObtenerUsuarioLogueado()?.Nombre</span>
                        <button class="btn btn-sm btn-outline-light" @onclick="CerrarSesion">
                            <i class="bi bi-box-arrow-right me-1"></i> Cerrar
                        </button>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<!-- CONTENIDO PRINCIPAL -->
<div class="container mt-4">
    @Body
</div>

@code {
    private void CerrarSesion()
    {
        AuthService.Logout();
        NavigationManager.NavigateTo("/login");
    }
}
